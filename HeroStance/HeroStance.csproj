<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>HeroStance</AssemblyName>
    <RootNamespace>HeroStance</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Only used with CopyToGame. Pass /p:BonelabPath="D:\Games\BONELAB" for a different install. -->
    <BonelabPath Condition="'$(BonelabPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\BONELAB</BonelabPath>

    <!-- Set to true (or pass /p:CopyToGame=true) to copy the built DLL straight into BONELAB\Mods. -->
    <CopyToGame Condition="'$(CopyToGame)' == ''">false</CopyToGame>
  </PropertyGroup>

  <!--
    Everything is compiled against public NuGet packages, so no BONELAB install is needed to build:
      - MelonLoader 0.6.0 (checked against 0.6.0, 0.6.1 and 0.7.1)
      - Il2CppInterop, which MelonLoader uses to expose IL2CPP games to C#
      - Il2CppInterop-generated Unity 2021.3 engine assemblies. These come from a reference package for
        another IL2CPP Unity game; the UnityEngine.* API surface is the same as BONELAB's, and the
        assemblies are only compiled against, never shipped.
    BoneLib and BONELAB's own types are reached by name at runtime (see BoneLibBridge.cs).
  -->
  <ItemGroup>
    <PackageReference Include="LavaGang.MelonLoader" Version="0.6.0" ExcludeAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Il2CppInterop.Runtime" Version="1.4.5" ExcludeAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Il2CppInterop.Common" Version="1.4.5" ExcludeAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="AmongUs.GameLibs.Itch" Version="2023.11.28" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(PkgLavaGang_MelonLoader)\lib\net6.0\MelonLoader.dll" Private="false" />
    <Reference Include="$(PkgIl2CppInterop_Runtime)\lib\net6.0\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(PkgIl2CppInterop_Common)\lib\netstandard2.0\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(PkgAmongUs_GameLibs_Itch)\build\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(PkgAmongUs_GameLibs_Itch)\build\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(PkgAmongUs_GameLibs_Itch)\build\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="$(PkgAmongUs_GameLibs_Itch)\build\UnityEngine.SharedInternalsModule.dll" Private="false" />
  </ItemGroup>

  <Target Name="CopyToBonelabMods" AfterTargets="Build" Condition="'$(CopyToGame)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BonelabPath)\Mods" />
  </Target>

</Project>
