<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>QuicksilverSandevistan</AssemblyName>
    <RootNamespace>Quicksilver</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>

    <!-- Point this at your BONELAB install, or pass /p:BonelabPath="D:\Games\BONELAB" on the command line. -->
    <BonelabPath Condition="'$(BonelabPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\BONELAB</BonelabPath>

    <!-- Set to true (or pass /p:CopyToGame=true) to copy the built DLL straight into BONELAB\Mods. -->
    <CopyToGame Condition="'$(CopyToGame)' == ''">false</CopyToGame>
  </PropertyGroup>

  <ItemGroup>
    <!-- SuperSlowMo is a separate mod with its own project -->
    <Compile Remove="SuperSlowMo\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- MelonLoader 0.6.x (net6) -->
    <Reference Include="$(BonelabPath)\MelonLoader\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(BonelabPath)\MelonLoader\net6\0Harmony.dll" Private="false" />
    <Reference Include="$(BonelabPath)\MelonLoader\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BonelabPath)\MelonLoader\net6\Il2CppInterop.Common.dll" Private="false" />

    <!-- Game + Unity assemblies generated by MelonLoader on first launch -->
    <Reference Include="$(BonelabPath)\MelonLoader\Il2CppAssemblies\*.dll" Private="false" />

    <!-- BoneLib 3.1.x -->
    <Reference Include="$(BonelabPath)\Mods\BoneLib.dll" Private="false" />
  </ItemGroup>

  <Target Name="CopyToBonelabMods" AfterTargets="Build" Condition="'$(CopyToGame)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BonelabPath)\Mods" />
  </Target>

</Project>
